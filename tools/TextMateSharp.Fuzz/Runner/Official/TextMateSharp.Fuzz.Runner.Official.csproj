<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runner built against the official TextMateSharp release (Onigwrap). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>False</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>TextMateSharp.Fuzz.Runner</AssemblyName>
    <OfficialTextMateSharpVersion Condition="'$(OfficialTextMateSharpVersion)' == ''">2.0.4</OfficialTextMateSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Runner.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TextMateSharp" Version="$(OfficialTextMateSharpVersion)" />
    <PackageReference Include="TextMateSharp.Grammars" Version="$(OfficialTextMateSharpVersion)" />
  </ItemGroup>

  <Import Project="..\..\..\..\build\Directory.Build.props" />
</Project>
